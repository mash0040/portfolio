# Stage 1: report-only. Validate deployed resources before switching to enforcement.
/*
  Content-Security-Policy-Report-Only: default-src 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self' https://static.cloudflareinsights.com/beacon.min.js; script-src-attr 'none'; style-src 'self' https://fonts.googleapis.com; style-src-attr 'none'; font-src 'self' https://fonts.gstatic.com; img-src 'self'; connect-src 'self' https://cloudflareinsights.com
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Independent, one-day host policies. Do not broaden to other subdomains or preload.
https://akmasha.dev/*
  Strict-Transport-Security: max-age=86400

# Applies only if Pages serves the response. The existing www redirect needs
# its own HSTS header at the redirect layer; _headers does not configure it.
https://www.akmasha.dev/*
  Strict-Transport-Security: max-age=86400
